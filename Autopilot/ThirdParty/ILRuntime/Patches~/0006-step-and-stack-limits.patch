無限ループと再帰の暴走で、ゲームを止めずに例外で打ち切る。解釈実行の呼び出しはネイティブの再帰になるので、スタックは残量で判定する。

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>

diff --git a/ILRuntime/Runtime/Enviorment/AppDomain.cs b/ILRuntime/Runtime/Enviorment/AppDomain.cs
index 38da4ae..6f72e72 100644
--- a/ILRuntime/Runtime/Enviorment/AppDomain.cs
+++ b/ILRuntime/Runtime/Enviorment/AppDomain.cs
@@ -73,6 +73,12 @@ namespace ILRuntime.Runtime.Enviorment
         Dictionary<string, byte[]> references = new Dictionary<string, byte[]>();
         DebugService debugService;
         AsyncJITCompileWorker jitWorker = new AsyncJITCompileWorker();
+        /// <summary>Dexc: instructions one entry from the host may run. Stops a loop that would otherwise hang the game.</summary>
+        public long StepLimit = long.MaxValue;
+        internal long StepsLeft = long.MaxValue;
+        /// <summary>Dexc: native stack the interpreter may use. Each interpreted call is a native call, and running out kills the process.</summary>
+        public long StackBudget = 512 * 1024;
+        internal long StackFloor;
         int defaultJITFlags;
         List<ModuleDefinition> loadedModules = new List<ModuleDefinition>();
         List<Assembly> referenceAssemblies = new List<Assembly>();
diff --git a/ILRuntime/Runtime/Intepreter/ILIntepreter.cs b/ILRuntime/Runtime/Intepreter/ILIntepreter.cs
index 94313aa..6539095 100644
--- a/ILRuntime/Runtime/Intepreter/ILIntepreter.cs
+++ b/ILRuntime/Runtime/Intepreter/ILIntepreter.cs
@@ -86,6 +86,11 @@ namespace ILRuntime.Runtime.Intepreter
         }
         public object Run(ILMethod method, object instance, object[] p)
         {
+            domain.StepsLeft = domain.StepLimit;
+            int stackProbe = 0;
+            long floor = (long)&stackProbe - domain.StackBudget;
+            if (floor > domain.StackFloor)
+                domain.StackFloor = floor;
             AutoList mStack = stack.ManagedStack;
             int mStackBase = mStack.Count;
             StackObject* esp = stack.StackBase;
@@ -112,6 +117,10 @@ namespace ILRuntime.Runtime.Intepreter
         }
         internal StackObject* Execute(ILMethod method, StackObject* esp, out bool unhandledException)
         {
+            // Dexc: see AppDomain.StackBudget.
+            int stackProbe = 0;
+            if ((long)&stackProbe < domain.StackFloor)
+                throw new StackOverflowException("The interpreter ran out of native stack.");
             allowUnboundCLRMethod = domain.AllowUnboundCLRMethod;
 #if DEBUG
             if (method == null)
@@ -282,6 +291,9 @@ namespace ILRuntime.Runtime.Intepreter
                         AppDomain.DebugService.CheckShouldBreak(method, this, insOffset);
 #endif
                         code = ip->Code;
+                        // Dexc: see AppDomain.StepLimit.
+                        if (--domain.StepsLeft < 0)
+                            throw new TimeoutException("The step limit was reached.");
                         switch (code)
                         {
 #region Arguments and Local Variable
