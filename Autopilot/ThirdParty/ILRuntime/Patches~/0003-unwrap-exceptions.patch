Reflection 経由の呼び出しは TargetInvocationException に包むので、catch が本来の型に一致しなかった。

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>

diff --git a/ILRuntime/Runtime/Intepreter/ILIntepreter.cs b/ILRuntime/Runtime/Intepreter/ILIntepreter.cs
index ca07d94..94313aa 100644
--- a/ILRuntime/Runtime/Intepreter/ILIntepreter.cs
+++ b/ILRuntime/Runtime/Intepreter/ILIntepreter.cs
@@ -4672,6 +4672,9 @@ namespace ILRuntime.Runtime.Intepreter
                     }
                     catch (Exception ex)
                     {
+                        // Dexc: a host call made by reflection wraps what it throws; catch clauses must see the real type.
+                        if (ex is System.Reflection.TargetInvocationException && ex.InnerException != null)
+                            ex = ex.InnerException;
                         var oriESP = esp;
                         if (ehs != null)
                         {
